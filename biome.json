{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.venv",
      "!**/.turbo",
      "!**/.next",
      "!**/test-results",
      "!**/playwright-report",
      "!**/dist",
      "!**/*.md",
      "!packages/schemas/json",
      "!**/pnpm-lock.yaml"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": { "enabled": true }
}
