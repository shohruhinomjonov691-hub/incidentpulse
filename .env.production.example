# NAMES ONLY. Copy to /opt/incidentpulse/secrets/.env on the server (chmod 600, owner root) and fill in there.
# Never put a value in this file, and never commit /opt/incidentpulse/secrets/.env (docs/DEPLOY.md, step 4).
#
# Generate every secret below with:  openssl rand -hex 32     (hex only: safe in compose interpolation)
# WEB_ADMIN_PASSWORD:                openssl rand -hex 24
# JSON values go in single quotes:   PROJECT_DOMAINS_JSON='{"kervan":["kervan.uz"]}'
#
# Use it with:  docker compose --env-file /opt/incidentpulse/secrets/.env -f compose.prod.yaml ...

# --- Datastores ---
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- LLM and budgets ---
OPENAI_API_KEY=
OPENAI_MODEL=
INCIDENT_BUDGET_USD=
WEEKLY_BUDGET_USD=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated numeric Telegram user ids allowed to press Approve / use /investigate and /stop
TELEGRAM_ALLOWED_USER_IDS=

# --- Shared secrets between services (each at least 32 characters) ---
WEBHOOK_HMAC_SECRET=
DEBATE_SHARED_SECRET=
POSTMORTEM_SHARED_SECRET=
# Signs Telegram buttons and approval tokens. The host runner has its own copy in
# /etc/incidentpulse/actions-runner.env (it re-verifies every token).
APPROVAL_HMAC_SECRET=

# --- Web UI ---
WEB_ADMIN_PASSWORD=
# Loopback port nginx proxies to (127.0.0.1:<port>). Empty = 3100. Not 3000: Kervan (pm2) uses it.
# If you set it, use the same value in the nginx vhost's proxy_pass (docs/DEPLOY.md, step 9).
WEB_HOST_PORT=

# --- Host runner socket group (gid of the incidentpulse-ipc group; docs/DEPLOY.md step 6) ---
IPC_GID=

# --- Allowlists (JSON) ---
PROJECT_DOMAINS_JSON=
PROJECT_CONTAINERS_JSON=
PROJECT_PM2_JSON=
PROJECT_ACTION_SCOPES_JSON=
# Optional: explicit health URLs per project. Empty = https://<domain>/ for every domain above.
HEALTH_POLL_URLS_JSON=

# --- Optional: Langfuse tracing (off unless BOTH keys are set; base URL must be https) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# --- Optional: image tag for rollbacks (docs/DEPLOY.md, rollback) ---
IP_TAG=
