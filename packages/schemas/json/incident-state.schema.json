{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "incidentId": {
      "type": "string"
    },
    "project": {
      "type": "string",
      "enum": [
        "gotrip",
        "kervan",
        "camera-studio",
        "codetrail",
        "findit",
        "food-lens"
      ]
    },
    "signal": {
      "type": "object",
      "properties": {
        "check": {
          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "check",
        "level",
        "summary",
        "at"
      ],
      "additionalProperties": false
    },
    "category": {
      "type": "string",
      "enum": [
        "tls",
        "dns",
        "http_5xx",
        "timeout",
        "container_down",
        "deploy_regression",
        "resource",
        "unknown"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "hash": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "source",
          "tool",
          "excerpt",
          "at",
          "hash"
        ],
        "additionalProperties": false
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "cause": {
            "type": "string"
          },
          "supportingEvidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "cause",
          "supportingEvidenceIds",
          "confidence"
        ],
        "additionalProperties": false
      }
    },
    "verdict": {
      "type": "object",
      "properties": {
        "hypothesisId": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dissent": {
          "type": "string"
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "hypothesisId",
        "confidence"
      ],
      "additionalProperties": false
    },
    "iteration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "remediation": {
      "type": "object",
      "properties": {
        "runbookId": {
          "type": "string",
          "enum": [
            "certbot_renew",
            "certbot_nginx_issue",
            "nginx_reload",
            "docker_restart",
            "pm2_restart",
            "docker_compose_up"
          ]
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "risk": {
          "type": "string",
          "enum": [
            "low",
            "medium"
          ]
        },
        "dryRunOutput": {
          "type": "string"
        }
      },
      "required": [
        "runbookId",
        "params",
        "risk"
      ],
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected",
            "expired"
          ]
        },
        "by": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "output": {
          "type": "string"
        }
      },
      "required": [
        "ok",
        "output"
      ],
      "additionalProperties": false
    },
    "recovery": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "check": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "ok",
        "check",
        "at"
      ],
      "additionalProperties": false
    },
    "postmortemUrl": {
      "type": "string"
    },
    "costUsd": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "incidentId",
    "project",
    "signal",
    "evidence",
    "hypotheses",
    "iteration",
    "costUsd"
  ],
  "additionalProperties": false
}
