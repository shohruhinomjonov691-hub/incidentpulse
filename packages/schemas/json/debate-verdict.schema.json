{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "hypothesisId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "dissent": {
      "type": "string",
      "maxLength": 500
    },
    "missing": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  },
  "required": [
    "hypothesisId",
    "confidence",
    "dissent",
    "missing"
  ],
  "additionalProperties": false
}
