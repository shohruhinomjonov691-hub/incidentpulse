# syntax=docker/dockerfile:1
# Python services (debate-verifier, postmortem-crew). Build with --build-arg SERVICE=<directory name>.
FROM python:3.12-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.13.9 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/venv
ARG SERVICE
WORKDIR /app/services/${SERVICE}
COPY services/${SERVICE}/pyproject.toml services/${SERVICE}/uv.lock services/${SERVICE}/.python-version ./
RUN --mount=type=cache,id=uv,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-install-project

FROM python:3.12-slim AS app
ARG SERVICE
ENV PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN useradd --system --uid 10001 --create-home app
COPY --from=build /opt/venv /opt/venv
WORKDIR /app
# The services read the shared JSON Schemas and the postmortem template relative to the repo root.
COPY packages/schemas/json /app/packages/schemas/json
COPY templates /app/templates
COPY services/${SERVICE}/src /app/services/${SERVICE}/src
USER app
