# Copy to .env (gitignored). Values here are placeholders or local-dev defaults only.
# Real secrets live in .env locally and in /opt/incidentpulse/secrets/*.env on the VPS, never in git.

# --- LLM (apps/orchestrator) ---
OPENAI_API_KEY=
# Default is a cheap model. If you change it to one not in packages/config KNOWN_PRICING,
# also set MODEL_PRICE_INPUT_PER_M and MODEL_PRICE_OUTPUT_PER_M (USD per 1M tokens).
OPENAI_MODEL=gpt-5.4-mini
# MODEL_PRICE_INPUT_PER_M=
# MODEL_PRICE_CACHED_INPUT_PER_M=
# MODEL_PRICE_OUTPUT_PER_M=
# Hard stop per incident, USD (SPEC §8)
INCIDENT_BUDGET_USD=0.50
# Shared LLM budget in USD, Monday–Sunday Asia/Seoul
WEEKLY_BUDGET_USD=0.50
# on_change (immediate) or weekly (Sunday 09:00 Asia/Seoul)
INVESTIGATE_MODE=on_change

# --- Telegram (apps/telegram-bot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated numeric Telegram user IDs. Empty disables /investigate polling.
# TELEGRAM_ALLOWED_USER_IDS=123456789

# --- Webhook signing (apps/intake + CodeTrail) ---
# Generate with: openssl rand -hex 32   (min 32 chars)
WEBHOOK_HMAC_SECRET=

# --- Local services (compose.yaml); defaults below match compose.yaml ---
POSTGRES_USER=incidentpulse
POSTGRES_PASSWORD=incidentpulse_dev
POSTGRES_DB=incidentpulse
REDIS_PASSWORD=incidentpulse_dev
# DATABASE_URL=postgres://incidentpulse:incidentpulse_dev@127.0.0.1:5432/incidentpulse
# REDIS_URL=redis://:incidentpulse_dev@127.0.0.1:6379

# --- Intake ---
# INTAKE_HOST=127.0.0.1
# INTAKE_PORT=8787

# --- Specialists (Phase 2). Anything left unset => that tool answers "not_configured" / the specialist is not offered ---
# Container name prefixes docker_ps / docker_logs may see, per project (the logs specialist)
# PROJECT_CONTAINERS_JSON={"kervan":["kervan-"]}
# CodeTrail HTTP API for the code specialist (search/explain need no key; a Bearer key is optional)
# CODETRAIL_BASE_URL=
# CODETRAIL_API_KEY=
# CODETRAIL_PROJECT_IDS_JSON={"kervan":"kervan"}
# FINE-GRAINED, READ-ONLY GitHub token (Contents: read, Metadata: read) for git_recent_commits.
# Do NOT reuse a broad personal token.
# GITHUB_READONLY_TOKEN=
# PROJECT_REPOS_JSON={"kervan":"owner/repo"}
# "strip" (default) removes prompt-injection-looking lines from tool output; "mark" only flags them
# INJECTION_MODE=strip

# --- Projects ---
# Domains per project (only kervan -> kervan.uz is built in). Example:
# PROJECT_DOMAINS_JSON={"gotrip":["gotrip.uz"]}

# --- Debate verifier (run on loopback or an authenticated private network) ---
DEBATE_MODE=auto
DEBATE_URL=http://127.0.0.1:8790
DEBATE_TIMEOUT_MS=32000
# Shared with the Python service. Generate with openssl rand -hex 32.
# DEBATE_SHARED_SECRET=

# --- Human-approved actions (Phase 4) ---
ACTIONS_ENABLED=false
# Configure a dedicated non-root Unix account and exact sudoers entries before enabling.
# ACTION_EXEC_USER=incidentpulse-actions
# Generate two independent values with openssl rand -hex 32.
# Execution tokens (orchestrator and dedicated runner only):
# APPROVAL_HMAC_SECRET=
# Telegram and web approval buttons:
# CALLBACK_HMAC_SECRET=
# Optional, for the trusted nginx forwarding header. Local direct logins use one bucket.
# WEB_PROXY_SECRET=
# Exact per-project action targets. Certificate domains come from PROJECT_DOMAINS_JSON.
# PROJECT_ACTION_SCOPES_JSON={"kervan":{"containers":["toy-app"],"pm2":["toy-api"],"nginx":true,"webroot":"/srv/www/acme","compose":{"name":"toy-stack","file":"/srv/toy/compose.yaml"}}}

# --- Observability (Phase 6): Langfuse tracing is OFF unless BOTH keys are set ---
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
