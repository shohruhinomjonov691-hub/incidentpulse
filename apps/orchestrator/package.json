{
  "name": "@incidentpulse/orchestrator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "LangGraph.js incident graph, Agents SDK agents, BullMQ worker.",
  "exports": {
    ".": "./src/index.ts",
    "./journal": "./src/journal.ts",
    "./budget": "./src/weekly-budget.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=../../.env src/main.ts",
    "show": "node --env-file-if-exists=../../.env scripts/show-incident.ts",
    "sandbox:eval": "NODE_EXTRA_CA_CERTS=../../sandbox/runtime/certs/ca.pem node --env-file-if-exists=../../.env scripts/sandbox-eval.ts"
  },
  "devDependencies": {
    "@incidentpulse/intake": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/pg": "8.23.1"
  },
  "dependencies": {
    "@incidentpulse/config": "workspace:*",
    "@incidentpulse/mcp-codetrail": "workspace:*",
    "@incidentpulse/mcp-infra": "workspace:*",
    "@incidentpulse/redact": "workspace:*",
    "@incidentpulse/schemas": "workspace:*",
    "@incidentpulse/telegram-bot": "workspace:*",
    "@langchain/core": "catalog:frameworks",
    "@langchain/langgraph": "catalog:frameworks",
    "@langchain/langgraph-checkpoint-postgres": "catalog:frameworks",
    "@openai/agents": "catalog:frameworks",
    "bullmq": "catalog:frameworks",
    "ioredis": "catalog:frameworks",
    "zod": "catalog:",
    "@incidentpulse/mcp-actions": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:frameworks",
    "pg": "8.23.1"
  }
}
