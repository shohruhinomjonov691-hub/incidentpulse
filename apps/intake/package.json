{
  "name": "@incidentpulse/intake",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fastify webhook receiver: verifies HMAC, dedups, enqueues.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
