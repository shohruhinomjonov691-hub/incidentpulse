  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@incidentpulse/config": "workspace:*",
    "@incidentpulse/redact": "workspace:*",
    "@incidentpulse/schemas": "workspace:*",
    "bullmq": "catalog:frameworks",
    "fastify": "catalog:frameworks",
    "ioredis": "catalog:frameworks",
    "zod": "catalog:"
  }
}
